# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-generate-with-secrets-token_urlsafe-50
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
POSTGRES_DB=ai_dashboard
POSTGRES_USER=ai_dashboard
POSTGRES_PASSWORD=devpassword
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Frontend dev — leave EMPTY. The app is served by the Vite dev server on
# 127.0.0.1:5173 and reaches the backend through Vite's proxy (/api → web:8000,
# /ws → web:8000) inside the Docker network, so the browser uses same-origin
# relative URLs. Do NOT point these at http://localhost:8000: host 127.0.0.1:8000
# is the `tls-proxy` (Caddy, HTTPS-only, for the Schwab OAuth callback), and a
# plain-HTTP request there returns 400 ("Client sent an HTTP request to an HTTPS
# server") that the browser misreports as a CORS error.
VITE_API_BASE_URL=
VITE_WS_BASE_URL=

# Schwab OAuth (register your app at https://developer.schwab.com; callback must match exactly)
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8000/api/schwab/callback
