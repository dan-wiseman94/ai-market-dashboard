# syntax=docker/dockerfile:1.7
FROM node:22-alpine

# System Chromium for the Storybook vitest browser lane (`vitest --project
# storybook`). Playwright's bundled Chromium can't run on Alpine/musl, so we
# install the system build and point Playwright at it via CHROMIUM_BIN. The
# symlink keeps the path stable across Alpine versions (chromium vs
# chromium-browser).
RUN apk add --no-cache \
      chromium nss freetype harfbuzz ca-certificates ttf-freefont \
 && ln -sf "$(command -v chromium-browser || command -v chromium)" /usr/local/bin/chromium
ENV CHROMIUM_BIN=/usr/local/bin/chromium \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

RUN corepack enable && mkdir -p /app && chown -R node:node /app

USER node
WORKDIR /app

COPY --chown=node:node package.json pnpm-lock.yaml* pnpm-workspace.yaml ./
RUN --mount=type=cache,target=/home/node/.local/share/pnpm/store,uid=1000,gid=1000 \
    pnpm install --frozen-lockfile || pnpm install

COPY --chown=node:node . .

EXPOSE 5173

CMD ["pnpm", "run", "dev"]
