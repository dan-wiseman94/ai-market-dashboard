{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Read(./.env.local)",
      "Edit(./.env.local)",
      "Read(./data/**)",
      "Edit(./data/**)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)",
      "Read(./**/secret.salt)"
    ],
    "allow": [
      "Bash(make lint)",
      "Bash(make test)",
      "Bash(make check)",
      "Bash(make migrate)",
      "Bash(make makemigrations)",
      "Bash(make e2e:*)",
      "Bash(make logs:*)",
      "Bash(make dev)",
      "Bash(make down)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose exec -T web pytest:*)",
      "Bash(docker compose exec -T --workdir /app web uv run pytest:*)",
      "Bash(docker compose exec -T frontend pnpm:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-secrets.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ruff-format-edited.sh" }
        ]
      }
    ]
  }
}
